# ==============================================================================
# ModelPulse Environment Configuration Template
# Copy this file to .env and replace placeholders with real values for local execution.
# NEVER commit .env to version control.
# ==============================================================================

# Application & API
APP_NAME=ModelPulse
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# PostgreSQL + TimescaleDB Database
POSTGRES_USER=modelpulse
POSTGRES_PASSWORD=modelpulse_password_placeholder
POSTGRES_DB=modelpulse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://modelpulse:modelpulse_password_placeholder@localhost:5432/modelpulse_db
PERSISTENCE_TYPE=in_memory
SQLITE_DB_PATH=data/modelpulse.db

# Kafka Streaming Broker (Phase 5)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=events
KAFKA_TOPIC_DLQ=events.dlq
KAFKA_TOPIC_RESULTS=monitoring.results
KAFKA_CONSUMER_GROUP=modelpulse-consumer-group
KAFKA_BATCH_INTERVAL_SECONDS=300
KAFKA_MAX_BATCH_SIZE=1000
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=500
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=False
KAFKA_MODE=memory

# Monitoring & Drift Windows
MICROBATCH_MINUTES=5
MONITOR_CYCLE_MINUTES=60
MIN_SAMPLES_FOR_DETECTION=500
DRIFT_ENSEMBLE_K=2
DRIFT_ENSEMBLE_M=3

# Alerting Channels & Configuration (Phase 6)
ALERT_MIN_SEVERITY=Medium
ALERT_COOLDOWN_SECONDS=1800
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/WEBHOOK/KEY
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=placeholder_app_password
ALERT_RECIPIENT_EMAIL=oncall@example.com

# Dashboard Configuration (Phase 6)
MODELPULSE_API_URL=http://localhost:8000
STREAMLIT_SERVER_PORT=8501

# Feature Store (Feast Local)
FEAST_USAGE=False
FEAST_REPO_PATH=ml/feast_repo

